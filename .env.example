# Copy to .env and fill in. Never commit .env.

# MySQL 8 connection
DATABASE_URL="mysql://britech:CHANGE_ME@127.0.0.1:3306/britech"

# Public site address (used in emails, sitemap, link previews). No trailing slash.
NEXT_PUBLIC_SITE_URL="https://britechsolutions.co.tz"

# Encrypts the SMTP password stored in the database. Generate once: openssl rand -hex 32
# Keep it stable — if it changes, re-enter the SMTP password in Admin → Site settings.
APP_SECRET=""

# Uploaded images (blog covers, logos). Must be a persistent folder that survives redeploys.
UPLOAD_DIR="/var/britech/uploads"

# Development only — scratch database used by `prisma migrate dev`.
# SHADOW_DATABASE_URL="mysql://britech:CHANGE_ME@127.0.0.1:3306/britech_shadow"
