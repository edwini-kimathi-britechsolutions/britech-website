// Britech Solutions — content database (MySQL)

generator client {
  provider      = "prisma-client-js"
  // "native" = this machine. The others let a build made on a Mac/PC run on typical Linux
  // hosting (cPanel/CloudLinux/AlmaLinux and Ubuntu) without regenerating on the server.
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url               = env("DATABASE_URL")
  // Dev only (prisma migrate dev). Not needed in production, which uses `prisma migrate deploy`.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN // everything, including users & settings
  EDITOR // all content; can publish any post
  AUTHOR // own posts only; submits for review
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum PartnerKind {
  PARTNER
  CLIENT
  BOTH
}

model User {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(100)
  role         Role      @default(AUTHOR)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  posts        Post[]
  media        Media[]
}

/// Server-side sessions. `id` is the SHA-256 hash of the cookie token,
/// so a leaked database row cannot be used to hijack a session.
model Session {
  id        String   @id @db.VarChar(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Failed sign-in attempts, used for rate limiting.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String   @db.VarChar(255) // email + ip
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Post {
  id          String     @id @default(cuid())
  title       String     @db.VarChar(200)
  slug        String     @unique @db.VarChar(191)
  excerpt     String     @db.VarChar(400)
  content     String     @db.LongText // sanitized HTML
  coverImage  String?    @db.VarChar(300)
  category    String     @default("News") @db.VarChar(60)
  tags        String     @default("") @db.VarChar(300) // comma separated
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model Project {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(191)
  client      String?  @db.VarChar(160)
  tagline     String   @db.VarChar(200)
  description String   @db.Text
  url         String?  @db.VarChar(300)
  logo        String?  @db.VarChar(300)
  sector      String?  @db.VarChar(80)
  highlights  String   @db.Text // one per line
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  isProduct   Boolean  @default(false) // Britech-owned platform → shown on /products
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, isProduct])
  @@index([sector])
}

model Partner {
  id        String      @id @default(cuid())
  name      String      @db.VarChar(160)
  logo      String      @db.VarChar(300)
  url       String?     @db.VarChar(300)
  kind      PartnerKind @default(PARTNER)
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([active, kind])
}

/// Simple key/value site settings (contact details, social links).
model Setting {
  key   String @id @db.VarChar(80)
  value String @db.Text
}

model Media {
  id         String   @id @default(cuid())
  filename   String   @unique @db.VarChar(191)
  original   String   @db.VarChar(255)
  mime       String   @db.VarChar(60)
  size       Int
  uploadedBy String?
  user       User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

enum InquiryStatus {
  NEW
  READ
  ARCHIVED
}

/// Messages sent from the website contact form.
model Inquiry {
  id         String        @id @default(cuid())
  firstName  String        @db.VarChar(80)
  lastName   String        @db.VarChar(80)
  company    String?       @db.VarChar(160)
  email      String        @db.VarChar(191)
  phone      String?       @db.VarChar(40)
  service    String        @db.VarChar(80)
  message    String        @db.Text
  status     InquiryStatus @default(NEW)
  ip         String?       @db.VarChar(64)
  emailedAt  DateTime? // when the notification email was sent
  emailError String?       @db.VarChar(500)
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}

/// Client quotes shown on the home page. Only add real, approved quotes.
model Testimonial {
  id           String   @id @default(cuid())
  quote        String   @db.Text
  name         String   @db.VarChar(120)
  role         String?  @db.VarChar(160)
  organization String?  @db.VarChar(160)
  photo        String?  @db.VarChar(300)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, sortOrder])
}
