# Britech Solutions website — Apache / LiteSpeed configuration (cPanel)

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (uncomment once SSL is active — cPanel → SSL/TLS Status → Run AutoSSL)
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Private folders and files are never served
  RewriteRule ^(app|storage)(/|$) - [F,L]
  # (/.well-known stays open: AutoSSL uses it to issue the certificate)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sql|md|log|lock|ini|sh)$ - [F,L]

  # Everything that isn't a real file goes to the PHP front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.php
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
  <FilesMatch "\.(css|js|woff2|png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# Uploaded images can be up to 5 MB (only raised where the host allows it)
<IfModule mod_php.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
</IfModule>
