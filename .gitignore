# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded media
/storage
/.next-*

# local secrets
/credentials
!.env.example

# PHP edition: local config, uploads and build output
/php-site/app/config.php
/php-site/storage/uploads/*
!/php-site/storage/uploads/.gitkeep
/dist

# design reference export (not part of the site)
/figma-web

# source documents (company profile, logo masters); the site uses copies in public/ and php-site/
/files
